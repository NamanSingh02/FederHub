# FederHub Federated Engine (Gamma) — Environment Variables
# Copy this file to .env and fill in the values.

# SQLite for local dev, PostgreSQL for production
# DATABASE_URL=sqlite:///./federhub_local.db
DATABASE_URL=postgresql://postgres:password@federhub-db.cq326a2yexwu.us-east-1.rds.amazonaws.com:5432/federhub

# gRPC server port
GRPC_PORT=50051

# Shared JWT secret — must match SECRET_KEY in backend/.env
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-secrets-token-hex-32
